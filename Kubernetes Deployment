apiVersion: apps/v1
kind: Deployment

metadata:
  name: aegisops

spec:
  replicas: 2

  selector:
    matchLabels:
      app: aegisops

  template:
    metadata:
      labels:
        app: aegisops

    spec:
      containers:
      - name: aegisops
        image: your-dockerhub/aegisops:latest

        ports:
        - containerPort: 8000
